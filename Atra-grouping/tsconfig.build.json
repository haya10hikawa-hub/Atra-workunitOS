{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "fixtures/src/**/*.ts",
    "backend/*/src/**/*.ts",
    "frontend/src/**/*.ts",
    "evaluation/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
