{
  "name": "atra-gold-annotation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "backend/*",
    "frontend",
    "evaluation",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run build && npm test",
    "annotate": "npm run build && node dist/frontend/src/cli.js"
  },
  "dependencies": {
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
