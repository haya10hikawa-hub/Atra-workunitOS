# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.env.local
.env.*.local
.dev.vars

# editor temp files
*.swp
*.swo
.*.swp
.*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts
/.open-next/
/.npm-cache/

# generated cloudflare deploy config (assembled from deploy env vars, holds real D1 IDs)
# committed base is `wrangler.json`; generated deploy configs must never be committed.
/wrangler.deploy*.json

# P0-PERSIST-015: generated operator bootstrap SQL (holds real tenant/user identity
# values) and local D1 evidence artifacts. Generated only; never committed.
/bootstrap.control*.sql
/.d1-evidence/

# P1-2 frozen evaluation dataset (WorkUnit: frozen two-provider dataset v1).
# Raw human conversational evidence — Gmail message octets above all — is acquired by a
# human, never by an assistant, and is never committed. The canonical private root lives
# OUTSIDE every git working tree (see docs/evaluation/P1_2_DATASET_FORMATION_PROTOCOL.md);
# these rules are a defense-in-depth trap for the case where a dataset is staged in-tree
# anyway. Only the content-free seal under docs/evaluation/ and tests/fixtures/p1-2/ is
# repository-controlled.
/.local/
*.private.json
*.private.jsonl
