# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.env.local
.env.*.local
.dev.vars

# editor temp files
*.swp
*.swo
.*.swp
.*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# A committed, secret-free template is the one intentional exception.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts
/.open-next/
/.npm-cache/

# generated cloudflare deploy config (assembled from deploy env vars, holds real D1 IDs)
# committed base is `wrangler.json`; generated deploy configs must never be committed.
/wrangler.deploy*.json

# P0-PERSIST-015: generated operator bootstrap SQL (holds real tenant/user identity
# values) and local D1 evidence artifacts. Generated only; never committed.
/bootstrap.control*.sql
/.d1-evidence/

# ---------------------------------------------------------------------------
# Public-repository boundary (docs/release/PUBLIC_REPOSITORY_POLICY.md).
#
# This file is a security contract, not a convenience list. Every pattern below
# keeps a class of private, generated, or secret-bearing material out of a
# repository that is intended to become publicly exportable. Do not add broad
# patterns (`/docs/`, `/scripts/`, `*.json`, `*.md`) here: they would silently
# hide legitimate public source instead of protecting private state.
# `tests/publicRepositoryBoundary.test.mts` asserts these rules stay in force.
# ---------------------------------------------------------------------------

# Private keys, certificates, and keystores. `*.pem` is covered above.
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore

# Local databases and SQL dumps. D1/SQLite state is local operator data and is
# never the canonical definition of a schema — `migrations/` is.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump.sql

# Cloudflare local runtime state (miniflare/wrangler caches, local D1 shards).
/.wrangler/
/.wrangler-state/

# Operator evidence bundles and execution artifacts. Evidence *schemas* and
# synthetic fixtures are public; real execution evidence carries tenant,
# operator, and environment context and is not.
/evidence/
/.loop-reports/
*.report.json
test-results.json
result-manifest.json
context-manifest.json
exact-head.diff

# Public-export staging. The exporter writes to an invocation-owned temporary
# directory; these are the in-repo fallbacks and must never be committed.
/public-export/
/release-staging/

# Agent- and session-local state. `.hermes/` was tracked until the public
# boundary work; it is local planning state with no runtime, build, test, or CI
# consumer, and it must not return. See PUBLIC_REPOSITORY_POLICY.md.
/.hermes/
/.atra/
/.claude/
/.codex/

# Editor and OS metadata beyond the swap files covered above.
.idea/
Thumbs.db
