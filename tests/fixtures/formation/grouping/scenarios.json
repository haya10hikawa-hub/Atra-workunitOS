      "right": { "sources": [{ "provider": "github", "sourceObjectId": "org/repo#11", "externalId": "pr-11", "occurredAt": "2026-01-01T00:00:00Z", "actors": ["Hayato"] }], "canonicalWorkObjectRef": { "provider": "github", "sourceObjectId": "org/repo#11" } },
