{
  "$schema": "https://opencode.ai/config.json",
  "model": "headroom-openrouter/openai/gpt-5.6-luna",
  "plugin": ["@dietrichgebert/ponytail"],
  "provider": {
    "headroom-openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom -> OpenRouter",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "openai/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna via Headroom",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "low"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low"
            }
          }
        }
      }
    },
    "openrouter-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter direct (evidence/review)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "openai/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna direct",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "low"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low"
            }
          }
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5 direct",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "edit": "ask",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf *": "deny",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npx tsc*": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git rev-parse*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny",
          "npm test*": "allow",
          "npm run test*": "allow",
          "npm run lint*": "allow",
          "npx tsc*": "allow"
        }
      }
    }
  }
}
